{
  "name": "erp-core-api-staging",
  "version": "0.6.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate --schema packages/db/prisma/schema.prisma && tsc -p packages/db/tsconfig.json && tsc -p tsconfig.json",
    "start": "npm run db:migrate:deploy && node start.mjs",
    "db:migrate:deploy": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:seed": "tsx packages/db/prisma/seed.ts"
  },
  "dependencies": {
    "@erp/db": "file:packages/db",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "fastify": "^5.6.1",
    "pino": "^9.9.4",
    "zod": "^4.1.11",
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3",
    "@types/node": "^24.19.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "22.x"
  }
}

