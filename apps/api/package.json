    "fastify": "^5.6.1",
    "pino": "^9.9.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
